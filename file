
public class tester{
  public static boolean isPrime(int x){
  for(int i = 2; i < x; i++){
    if(x % i == 0){
      return false;
      }
    }
  return x > 1;
  }
  public static int nthPrime(int n){
    int count = 1;
    for(int i = -1; i < n; count++){
      if(isPrime(count)){
        i++;
      }
    }
    return count - 1;
  }
  public static void main(String[] args) {
    int[] inputs = {0, 1, 2, 3, 4, 5, 9, 10, 20, 50, 100, 200};
    int[] values = {2, 3, 5, 7, 11, 13, 29, 31, 73, 233, 547, 1229};

    for(int i = 0; i < inputs.length; i++){
      if(nthPrime(inputs[i]) == values[i]){
        System.out.println("Pass");
      }
      else{
        System.out.println("Fail expected " + values[i] + ", but value returned was " + nthPrime(inputs[i]));
      }
    }
  }
}



